{% extends 'base.html.twig' %}

{% block title %}{{ evenement.titre }} — A Skalinata{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 700px;">
    <a href="{{ path('app_accueil') }}" class="text-decoration-none text-muted small">&larr; Retour aux événements</a>

    <div class="card evenement-card mt-3">
        <div class="card-body p-4 p-md-5">
            <p class="section-eyebrow mb-2">{{ evenement.exterieur ? 'Événement extérieur' : 'Événement' }}</p>
            <h1 class="h3 mb-3">{{ evenement.titre }}</h1>

            {% if evenement.description %}
                <p class="text-muted">{{ evenement.description }}</p>
            {% endif %}

            <dl class="event-meta my-4">
                <div class="event-meta-row">
                    <dt>Date</dt>
                    <dd>{{ evenement.dateDebut|date('d/m/Y H:i') }} – {{ evenement.dateFin|date('H:i') }}</dd>
                </div>
                <div class="event-meta-row">
                    <dt>Lieu</dt>
                    <dd>
                        {% if evenement.exterieur %}
                            {{ evenement.lieuLabel }} <span class="badge bg-success ms-1">Extérieur</span>
                        {% else %}
                            {{ evenement.salle.nom }} — {{ evenement.salle.site.ville }} ({{ evenement.salle.site.nom }})
                        {% endif %}
                    </dd>
                </div>
                <div class="event-meta-row">
                    <dt>Places</dt>
                    <dd>
                        {% if evenement.exterieur %}
                            <span class="badge badge-places">Places illimitées</span>
                        {% elseif evenement.complet %}
                            <span class="badge badge-complet">Complet</span>
                        {% else %}
                            <span class="badge badge-places">{{ evenement.placesRestantes }} / {{ evenement.salle.capacite }} places restantes</span>
                        {% endif %}
                    </dd>
                </div>
            </dl>

            {% if is_granted('ROLE_USER') %}
                {% if reservationActive %}
                    <div class="alert alert-success">Vous êtes inscrit·e à cet événement.</div>
                    <form method="post" action="{{ path('app_reservation_annuler', {id: reservationActive.id}) }}" onsubmit="return confirm('Annuler votre réservation ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('annuler' ~ reservationActive.id) }}">
                        <button type="submit" class="btn btn-outline-primary">Annuler ma réservation</button>
                    </form>
                {% elseif evenement.exterieur or evenement.placesRestantes > 0 %}
                    <form method="post" action="{{ path('app_evenement_reserver', {id: evenement.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('reserver' ~ evenement.id) }}">
                        <button type="submit" class="btn btn-primary">Réserver ma place</button>
                    </form>
                {% else %}
                    <button class="btn btn-secondary" disabled>Événement complet</button>
                {% endif %}
                <p class="text-muted small mt-2 mb-0">Réservation et annulation possibles jusqu'à 1h avant le début de l'événement.</p>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-primary">Se connecter pour réserver</a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
