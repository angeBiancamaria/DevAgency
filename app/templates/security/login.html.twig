{% extends 'base.html.twig' %}

{% block title %}Connexion — A Skalinata{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-card">
        <p class="auth-brand">A <span>Skalinata</span></p>
        <h1>Connexion</h1>
        <p class="auth-subtitle">Accédez à votre espace A Skalinata.</p>

        {% if error %}
            <div class="alert alert-danger py-2">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post">
            <div class="mb-3">
                <label for="username">Adresse email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
            </div>
            <div class="mb-3">
                <label for="password">Mot de passe</label>
                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="btn btn-primary mt-2" type="submit">Se connecter</button>
        </form>

        <div class="auth-switch">
            Pas encore de compte ? <a href="{{ path('app_register') }}">S'inscrire</a>
        </div>
    </div>
</div>
{% endblock %}
